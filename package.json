{
	"name": "@erhahahaa/midtrans-client-typescript",
	"version": "1.0.7",
	"description": "Unofficical typescript version of midtrans client.",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"prepublishOnly": "npm run build",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/erhahahaa/midtrans-client-typescript.git"
	},
	"keywords": [
		"midtrans",
		"typescript",
		"payment"
	],
	"author": "Rahmat Hidayatullah",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/erhahahaa/midtrans-client-typescript/issues"
	},
	"homepage": "https://github.com/erhahahaa/midtrans-client-typescript#readme",
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/node": "^24.9.2",
		"tsdown": "^0.15.12"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
